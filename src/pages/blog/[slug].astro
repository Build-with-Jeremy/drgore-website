---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blogPosts';
import { linkify } from '../../utils/linkify';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const canonical = `https://drgore.com/blog/${post.slug}`;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.summary,
  image: `https://drgore.com${post.thumbnail}`,
  author: {
    '@type': 'Person',
    name: 'Dr. David Karol Gore',
    url: 'https://drgore.com/biography',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Dr. David Karol Gore',
    logo: { '@type': 'ImageObject', url: 'https://drgore.com/assets/og-image.jpg' },
  },
  mainEntityOfPage: canonical,
  ...(post.date ? { datePublished: post.date } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://drgore.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://drgore.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
  ],
};
---
<Layout
  title={`${post.title} — Dr. David Karol Gore`}
  description={post.summary}
  canonical={canonical}
  schema={[blogSchema, breadcrumbSchema]}
>
  <section class="py-16 bg-secondary">
    <div class="container max-w-3xl">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary mb-6 transition-colors"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to Blog
      </a>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-2">
        {post.title}
      </h1>
      <p class="text-sm text-muted-foreground">{post.date}</p>
    </div>
  </section>

  <section class="py-16">
    <div class="container max-w-3xl">
      <div class="rounded-xl overflow-hidden mb-10 aspect-[2/1] bg-gradient-to-br from-secondary to-muted">
        <img
          src={post.thumbnail}
          alt={post.title}
          class="w-full h-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
      <div class="space-y-5">
        {post.content.map((paragraph: string) => (
          <p class="text-muted-foreground leading-relaxed whitespace-pre-line">
            {linkify(paragraph).map((segment) =>
              segment.type === 'link' ? (
                <a
                  href={segment.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary underline underline-offset-2 hover:no-underline break-words"
                >{segment.value}</a>
              ) : (
                segment.value
              )
            )}
          </p>
        ))}
      </div>

      {post.video && (
        <div class="mt-10">
          <div class="relative w-full overflow-hidden rounded-xl bg-muted aspect-video">
            <iframe
              src={post.video.provider === "facebook"
                ? `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(post.video.url)}&show_text=false`
                : post.video.url.replace("watch?v=", "embed/")}
              title={post.video.title}
              class="absolute inset-0 w-full h-full"
              style="border:none;overflow:hidden"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      )}

      <div class="mt-12 pt-8 border-t border-border">
        <p class="text-foreground font-medium mb-2">
          Ready to break the cycle?
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-5 py-2.5 rounded-md font-medium hover:bg-primary/90 transition-colors"
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
